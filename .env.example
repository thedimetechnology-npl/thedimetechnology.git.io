# WhatsApp Bot — Owner will get inquiry on +9779801024024
# Choose ONE provider below. If none is set, /api/inquiry runs in demo mode (logs + returns wa.me link)

# Option 1: Meta WhatsApp Cloud API (RECOMMENDED — free, official)
# Get from developers.facebook.com → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_TO=9779801024024

# Option 2: UltraMsg (https://ultramsg.com) — easy, no Meta review
# ULTRAMSG_INSTANCE_ID=instance12345
# ULTRAMSG_TOKEN=abcd1234

# Option 3: CallMeBot (https://callmebot.com) — free, just need apikey
# CALLMEBOT_APIKEY=123456
