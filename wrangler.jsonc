{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thedimetechnology-git-io",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "bucket_name": "dime-uploads",
      "binding": "R2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dime-db",
      "database_id": "c5682bd8-9061-447f-96e5-8bfa58407919"
    }
  ]
}
